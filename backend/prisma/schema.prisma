generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default(uuid())
  teamName    String
  githubUrl   String
  createdAt   DateTime     @default(now())
  evaluations Evaluation[]
}

model Evaluation {
  id               String           @id @default(uuid())
  projectId        String
  score            Int?
  exaggerations    Json?
  reality          String?
  status           EvaluationStatus @default(PENDING)
  pptContent       String?
  slideImageCount  Int?
  githubFileTree   Json?
  githubReadme     String?
  promptSent       String?
  rawAiResponse    String?
  processingTimeMs Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  claimsVerified   Json?
  repoStats        Json?
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Participant {
  id                              String             @id @default(uuid())
  fullName                        String?
  liveSelfieUrl                   String?
  idCardUrl                       String?
  aadhaarEncrypted                String?
  phone                           String?
  email                           String             @unique
  motivation                      String?
  pastProjects                    String[]
  githubUrl                       String?
  linkedinUrl                     String?
  roleSelection                   String?
  sleepHabits                     String?
  dietaryPref                     String?
  teamId                          String?
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
  faceEmbedding                   Json?
  college                         String?
  githubAccessToken               String?
  githubRefreshToken              String?
  hackathonPreferences            Json?
  password                        String?
  positionOfResponsibility        Json?
  projects                        Json?
  role                            String             @default("USER")
  socialLinks                     Json?
  tagline                         String?
  workExperience                  Json?
  achievements                    String[]
  certifications                  String[]
  education                       String[]
  primarySkillset                 String[]
  chatSessions                    ChatSession[]
  Hackathon                       Hackathon[]
  team                            Team?              @relation(fields: [teamId], references: [id])
  PushSubscription                PushSubscription[]
  Registration                    Registration[]
  Team_Team_leaderIdToParticipant Team[]             @relation("Team_leaderIdToParticipant")
}

model Team {
  id                                     String        @id @default(uuid())
  teamName                               String
  leadEmail                              String
  memberEmails                           String[]
  createdAt                              DateTime      @default(now())
  hackathonId                            String?
  inviteCode                             String?       @unique
  leaderId                               String?
  status                                 String        @default("INCOMPLETE")
  participants                           Participant[]
  Hackathon                              Hackathon?    @relation(fields: [hackathonId], references: [id])
  Participant_Team_leaderIdToParticipant Participant?  @relation("Team_leaderIdToParticipant", fields: [leaderId], references: [id])
}

model ChatSession {
  id            String      @id @default(uuid())
  participantId String
  history       Json        @default("[]")
  extractedData Json?
  isComplete    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model RoundConfig {
  id               String           @id @default(uuid())
  targetShortlist  Int              @default(10)
  maxSlides        Int              @default(15)
  domains          String[]
  keywords         String[]
  problemStatement String?
  /// JSON: { problemRelevance:25, innovation:25, technicalDepth:20, marketImpact:15, slideQuality:15 }
  scoringWeights   Json?
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  submissions      ShortlistEntry[]
}

model ShortlistEntry {
  id               String      @id @default(uuid())
  configId         String
  teamName         String
  githubUrl        String?
  pptxPath         String?
  status           RoundStatus @default(PENDING)
  slideCount       Int?
  /// Raw per-criterion scores from Groq (1–10 each) — kept for re-scoring on weight changes
  pptScores        Json?
  /// XAI: one-sentence reason per criterion
  pptXaiReasons    Json?
  /// Weighted 0–100 score (recomputed from pptScores + config weights)
  finalScore       Float?
  rawGroqResponse  String?
  processingTimeMs Int?
  /// Admin manual score override
  adminOverride    Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  /// Admin-private note — NEVER exposed to participant API
  adminNote        String?
  failReason       String?
  /// Set on publish: 1 = best. Tiebreak: finalScore DESC, createdAt ASC
  rank             Int?
  config           RoundConfig @relation(fields: [configId], references: [id])
}

model Domain {
  id          String    @id
  name        String
  problems    Json
  hackathonId String
  Hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model Hackathon {
  id                   String          @id
  name                 String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  location             String
  description          String?
  posterUrl            String?
  prizePool            String?
  totalTeams           Int?
  teamSize             Int             @default(3)
  totalOfflineTeams    Int?
  totalRemoteTeams     Int?
  venueMapUrl          String?
  ndaRequired          Boolean         @default(false)
  status               String          @default("Active")
  sponsors             Json?
  rules                Json?
  requiredFields       Json?
  adminId              String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime
  psReleaseDate        DateTime?
  psReleasedPushSent   Boolean         @default(false)
  Domain               Domain[]
  Participant          Participant     @relation(fields: [adminId], references: [id])
  Registration         Registration[]
  Room                 Room[]
  Team                 Team[]
  TimelineEvent        TimelineEvent[]
}

model PushSubscription {
  id            String      @id
  participantId String
  endpoint      String      @unique
  p256dh        String
  auth          String
  createdAt     DateTime    @default(now())
  Participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Registration {
  id             String      @id
  participantId  String
  hackathonId    String
  dynamicAnswers Json?
  status         String      @default("SOLO")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  Hackathon      Hackathon   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  Participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, hackathonId])
}

model Room {
  id          String    @id
  name        String
  capacity    String
  hackathonId String
  Hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id          String    @id
  time        String
  event       String
  hackathonId String
  Hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

enum RoundStatus {
  PENDING
  PROCESSING
  EVALUATED
  ELIMINATED
  FAILED
}

enum EvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
