generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default(uuid())
  teamName    String
  githubUrl   String
  createdAt   DateTime     @default(now())
  evaluations Evaluation[]
}

model Evaluation {
  id               String           @id @default(uuid())
  projectId        String
  score            Int?
  exaggerations    Json?
  reality          String?
  status           EvaluationStatus @default(PENDING)
  pptContent       String?
  slideImageCount  Int?
  githubFileTree   Json?
  githubReadme     String?
  promptSent       String?
  rawAiResponse    String?
  processingTimeMs Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  claimsVerified   Json?
  repoStats        Json?
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Participant {
  id                       String   @id @default(uuid())
  fullName                 String?
  liveSelfieUrl            String?
  idCardUrl                String?
  aadhaarEncrypted         String?
  phone                    String?
  faceEmbedding            Json?
  email                    String   @unique
  password                 String?
  role                     String   @default("USER") // Can be "USER" or "ADMIN"
  college                  String?
  education                String[]
  githubAccessToken        String?
  githubRefreshToken       String?
  primarySkillset          String[]
  tagline                  String?
  projects                 Json?
  workExperience           Json?
  positionOfResponsibility Json?
  achievements             String[]
  certifications           String[]
  socialLinks              Json?
  hackathonPreferences     Json?
  motivation               String?
  pastProjects             String[]
  githubUrl                String?
  linkedinUrl              String?
  roleSelection            String?
  sleepHabits              String?
  dietaryPref              String?
  teamId                   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  chatSessions  ChatSession[]
  team          Team?          @relation(fields: [teamId], references: [id])
  hackathons    Hackathon[]    @relation("AdminHackathons") // Hackathons created by this admin
  leadsTeams    Team[]         @relation("TeamLeader")
  registrations Registration[]
}

model Team {
  id           String   @id @default(uuid())
  teamName     String
  leadEmail    String
  memberEmails String[]
  createdAt    DateTime @default(now())

  // Registration specifics
  hackathonId String?
  hackathon   Hackathon?   @relation(fields: [hackathonId], references: [id])
  leaderId    String?
  leader      Participant? @relation("TeamLeader", fields: [leaderId], references: [id])
  inviteCode  String?      @unique
  status      String       @default("INCOMPLETE") // INCOMPLETE, REGISTERED

  participants Participant[]
}

model ChatSession {
  id            String      @id @default(uuid())
  participantId String
  history       Json        @default("[]")
  extractedData Json?
  isComplete    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model RoundConfig {
  id               String           @id @default(uuid())
  targetShortlist  Int              @default(10)
  maxSlides        Int              @default(15)
  domains          String[]
  keywords         String[]
  problemStatement String?
  /// JSON: { problemRelevance:25, innovation:25, technicalDepth:20, marketImpact:15, slideQuality:15 }
  scoringWeights   Json?
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  submissions      ShortlistEntry[]
}

model ShortlistEntry {
  id               String      @id @default(uuid())
  configId         String
  teamName         String
  githubUrl        String?
  pptxPath         String?
  status           RoundStatus @default(PENDING)
  slideCount       Int?
  /// Raw per-criterion scores from Groq (1–10 each) — kept for re-scoring on weight changes
  pptScores        Json?
  /// XAI: one-sentence reason per criterion
  pptXaiReasons    Json?
  /// Weighted 0–100 score (recomputed from pptScores + config weights)
  finalScore       Float?
  rawGroqResponse  String?
  processingTimeMs Int?
  /// Admin manual score override
  adminOverride    Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  /// Admin-private note — NEVER exposed to participant API
  adminNote        String?
  failReason       String?
  /// Set on publish: 1 = best. Tiebreak: finalScore DESC, createdAt ASC
  rank             Int?
  config           RoundConfig @relation(fields: [configId], references: [id])
}

model Hackathon {
  id                   String    @id @default(uuid())
  name                 String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime? // Deadline for registrations
  location             String
  description          String?
  posterUrl            String? // Frontend uploads to S3/Cloudinary and sends URL
  prizePool            String?
  totalTeams           Int?
  teamSize             Int       @default(3)
  totalOfflineTeams    Int?
  totalRemoteTeams     Int?
  venueMapUrl          String?
  ndaRequired          Boolean   @default(false)
  status               String    @default("Active") // e.g., "Active", "Completed"

  // JSON arrays for simple lists
  sponsors       Json? // Array of strings: ["Google", "GitHub"]
  rules          Json? // Array of strings: ["Rule 1", "Rule 2"]
  requiredFields Json? // Array of required registration fields: ["github", "college"]

  // Relations
  adminId       String
  admin         Participant     @relation("AdminHackathons", fields: [adminId], references: [id])
  domains       Domain[]
  rooms         Room[]
  timeline      TimelineEvent[]
  teams         Team[]
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Registration {
  id             String      @id @default(uuid())
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  hackathonId    String
  hackathon      Hackathon   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  dynamicAnswers Json? // Stores answers for hackathon.requiredFields
  status         String      @default("SOLO") // SOLO, IN_TEAM
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([participantId, hackathonId])
}

model Domain {
  id          String    @id @default(uuid())
  name        String
  problems    Json // Array of strings
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model Room {
  id          String    @id @default(uuid())
  name        String
  capacity    String // Kept as string to allow "—" or "50+" based on your frontend
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id          String    @id @default(uuid())
  time        String
  event       String
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

enum RoundStatus {
  PENDING
  PROCESSING
  EVALUATED
  ELIMINATED
  FAILED
}

enum EvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
