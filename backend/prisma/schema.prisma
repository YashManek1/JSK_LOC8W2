generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  JUDGE
  MENTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Project {
  id          String       @id @default(uuid())
  teamName    String
  githubUrl   String
  createdAt   DateTime     @default(now())
  evaluations Evaluation[]
}

model Evaluation {
  id               String           @id @default(uuid())
  projectId        String
  score            Int?
  exaggerations    Json?
  reality          String?
  status           EvaluationStatus @default(PENDING)
  pptContent       String?
  slideImageCount  Int?
  githubFileTree   Json?
  githubReadme     String?
  promptSent       String?
  rawAiResponse    String?
  processingTimeMs Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  claimsVerified   Json?
  repoStats        Json?
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Participant {
  id                       String             @id @default(uuid())
  fullName                 String?
  liveSelfieUrl            String?
  idCardUrl                String?
  aadhaarEncrypted         String?
  phone                    String?
  email                    String             @unique
  motivation               String?
  pastProjects             String[]
  githubUrl                String?
  linkedinUrl              String?
  roleSelection            String?
  sleepHabits              String?
  dietaryPref              String?
  teamId                   String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  faceEmbedding            Json?
  college                  String?
  githubAccessToken        String?
  githubRefreshToken       String?
  hackathonPreferences     Json?
  password                 String?
  positionOfResponsibility Json?
  projects                 Json?
  role                     String             @default("PARTICIPANT")
  status                   String             @default("ACTIVE")
  socialLinks              Json?
  tagline                  String?
  workExperience           Json?
  achievements             String[]
  certifications           String[]
  primarySkillset          String[]
  portfolioUrl             String?
  education                Json?
  chatSessions             ChatSession[]
  hackathons               Hackathon[]        @relation("AdminHackathons")
  team                     Team?              @relation(fields: [teamId], references: [id])
  pushSubscriptions        PushSubscription[]
  registrations            Registration[]
  leadsTeams               Team[]             @relation("TeamLeader")
  checkInQRs               CheckInQR[]
  mealQRs                  MealQR[]
  discussions              Discussion[]
  evaluationsGiven         JudgeEvaluation[]  @relation("JudgeToEvaluation")
  isProfileComplete        Boolean            @default(false)
  stats                    Json?              // { hackathonsParticipated, projectsBuilt, globalRank }
  skills                   String[]
  lookingForTeam           Boolean            @default(false)
  resumeUrl                String?
}

model JudgeEvaluation {
  id               String      @id @default(uuid())
  teamId           String
  judgeId          String
  innovationScore  Int         @default(0)
  feasibilityScore Int         @default(0)
  techDepthScore   Int         @default(0)
  clarityScore     Int         @default(0)
  impactScore      Int         @default(0)
  totalScore       Int         @default(0)
  note             String?
  createdAt        DateTime    @default(now())

  team             Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judge            Participant @relation("JudgeToEvaluation", fields: [judgeId], references: [id], onDelete: Cascade)
}

model Discussion {
  id        String      @id @default(uuid())
  title     String
  content   String
  authorId  String
  likes     Int         @default(0)
  replies   Json?       // Array of replies
  createdAt DateTime    @default(now())

  author    Participant @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Team {
  id           String        @id @default(uuid())
  teamName     String
  leadEmail    String
  memberEmails String[]
  createdAt    DateTime      @default(now())
  hackathonId  String?
  inviteCode   String?       @unique
  leaderId     String?
  status           String        @default("INCOMPLETE")
  psPreferences    Json?
  allocatedDomainId String?
  participants     Participant[]
  hackathon        Hackathon?    @relation(fields: [hackathonId], references: [id])
  leader           Participant?  @relation("TeamLeader", fields: [leaderId], references: [id])
  allocatedDomain  Domain?       @relation("AllocatedDomain", fields: [allocatedDomainId], references: [id])
  evaluations      JudgeEvaluation[]
}

model ChatSession {
  id            String      @id @default(uuid())
  participantId String
  history       Json        @default("[]")
  extractedData Json?
  isComplete    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model RoundConfig {
  id               String           @id @default(uuid())
  targetShortlist  Int              @default(10)
  maxSlides        Int              @default(15)
  domains          String[]
  keywords         String[]
  problemStatement String?
  /// JSON: { problemRelevance:25, innovation:25, technicalDepth:20, marketImpact:15, slideQuality:15 }
  scoringWeights   Json?
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  submissions      ShortlistEntry[]
}

model ShortlistEntry {
  id               String      @id @default(uuid())
  configId         String
  teamName         String
  githubUrl        String?
  pptxPath         String?
  status           RoundStatus @default(PENDING)
  slideCount       Int?
  /// Raw per-criterion scores from Groq (1–10 each) — kept for re-scoring on weight changes
  pptScores        Json?
  /// XAI: one-sentence reason per criterion
  pptXaiReasons    Json?
  /// Weighted 0–100 score (recomputed from pptScores + config weights)
  finalScore       Float?
  rawGroqResponse  String?
  processingTimeMs Int?
  /// Admin manual score override
  adminOverride    Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  /// Admin-private note — NEVER exposed to participant API
  adminNote        String?
  failReason       String?
  /// Set on publish: 1 = best. Tiebreak: finalScore DESC, createdAt ASC
  rank             Int?
  config           RoundConfig @relation(fields: [configId], references: [id])
}

model Hackathon {
  id                   String          @id @default(uuid())
  name                 String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  location             String
  description          String?
  posterUrl            String?
  prizePool            String?
  totalTeams           Int?
  teamSize             Int             @default(3)
  totalOfflineTeams    Int?
  totalRemoteTeams     Int?
  venueMapUrl          String?
  ndaRequired          Boolean         @default(false)
  status               String          @default("Active")
  sponsors             Json?
  rules                Json?
  requiredFields       Json?
  mealTimes            Json?           // { breakfast: "08:00", lunch: "13:00", dinner: "20:00" }
  qrGenerated          Boolean         @default(false)
  adminId              String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  psReleaseDate        DateTime?
  psReleasedPushSent   Boolean         @default(false)
  domains              Domain[]
  admin                Participant     @relation("AdminHackathons", fields: [adminId], references: [id])
  registrations        Registration[]
  rooms                Room[]
  teams                Team[]
  timeline             TimelineEvent[]
  checkInQRs           CheckInQR[]
  mealQRs              MealQR[]
}

model Registration {
  id             String      @id @default(uuid())
  participantId  String
  hackathonId    String
  dynamicAnswers Json?
  status         String      @default("SOLO")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  hackathon      Hackathon   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, hackathonId])
}

model Domain {
  id          String    @id @default(uuid())
  name        String
  problems    Json
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  teams       Team[]    @relation("AllocatedDomain")
}

model Room {
  id          String    @id @default(uuid())
  name        String
  capacity    String
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id          String    @id @default(uuid())
  time        String
  event       String
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id            String      @id @default(uuid())
  participantId String
  endpoint      String      @unique
  p256dh        String
  auth          String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

enum RoundStatus {
  PENDING
  PROCESSING
  EVALUATED
  ELIMINATED
  FAILED
}

enum EvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CheckInQR {
  id            String      @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  hackathonId   String
  hackathon     Hackathon   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  qrToken       String      @unique @default(uuid())
  isCheckedIn   Boolean     @default(false)
  checkedInAt   DateTime?
  emailSent     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([participantId, hackathonId])
}

model MealQR {
  id            String      @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  hackathonId   String
  hackathon     Hackathon   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  mealType      String      // BREAKFAST | LUNCH | DINNER
  mealDate      DateTime    // The date of this specific meal
  qrToken       String      @unique @default(uuid())
  isScanned     Boolean     @default(false)
  scannedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@unique([participantId, hackathonId, mealType, mealDate])
}
