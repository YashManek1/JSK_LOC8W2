{
  "info": {
    "_postman_id": "loc-prep-complete-2026",
    "name": "LOC_PREP - Complete API Collection",
    "description": "Complete API collection for LOC_PREP Hackathon Platform\n\nBackend: NestJS on port 3000\nFrontend: Vite React on port 5173\nDatabase: PostgreSQL (Supabase)\nRedis: BullMQ Queue Management\n\nFeatures:\n- GitHub Analytics with AI Codebase Evaluation\n- Shortlist Management with Groq AI Scoring\n- Voice Chat Interview System\n- Identity Verification\n- Gamification & Leaderboards",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jskloc8w2-production.up.railway.app",
      "type": "string",
      "description": "NestJS Backend Server (Railway)"
    },
    {
      "key": "frontendUrl",
      "value": "http://localhost:5173",
      "type": "string",
      "description": "Vite Frontend Server"
    },
    {
      "key": "teamName",
      "value": "Team Innovix",
      "type": "string"
    },
    {
      "key": "entryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "alice-coder",
      "type": "string"
    },
    {
      "key": "hackathonId",
      "value": "some-uuid",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🩺 Health Check",
      "item": [
        {
          "name": "Backend Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Check if backend is running"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🚀 GitHub Analytics",
      "description": "Real-time GitHub repository analysis with AI-powered codebase evaluation using Repomix + Groq",
      "item": [
        {
          "name": "Sync Repository Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✅ Repository synced successfully');",
                  "    var jsonData = pm.response.json();",
                  "    console.log('Total Commits:', jsonData.totalCommits);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamName\": \"{{teamName}}\",\n  \"githubUrl\": \"https://github.com/facebook/react\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/github/sync/{{teamName}}",
              "host": ["{{baseUrl}}"],
              "path": ["github", "sync", "{{teamName}}"]
            },
            "description": "**Force sync GitHub repository statistics**\n\nThis endpoint:\n1. Fetches contributors, commits, languages from GitHub API\n2. Packs codebase using Repomix\n3. Runs Groq AI evaluation against problem statement\n4. Maps features to individual developers\n5. Caches everything in PostgreSQL\n\n**Rate Limits:** Uses GROQ_API_KEY_SECONDARY to isolate quotas"
          },
          "response": []
        },
        {
          "name": "Get Repository Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('GitHub Data:', jsonData.githubData);",
                  "    console.log('AI Analysis:', jsonData.aiData);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/github/stats/{{teamName}}",
              "host": ["{{baseUrl}}"],
              "path": ["github", "stats", "{{teamName}}"]
            },
            "description": "**Retrieve cached GitHub statistics**\n\nReturns:\n- `githubData`: Contributors, commits, languages, timeline\n- `aiData`: Implemented features, missing features, relevance score\n\nAuto-syncs if cache is older than 1 hour"
          },
          "response": []
        },
        {
          "name": "Sync by Entry ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUrl\": \"https://github.com/username/repo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/github/sync/{{entryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["github", "sync", "{{entryId}}"]
            },
            "description": "Sync using shortlist entry UUID instead of team name"
          },
          "response": []
        }
      ]
    },
