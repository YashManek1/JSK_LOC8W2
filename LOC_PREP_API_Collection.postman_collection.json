    {
      "name": "📊 Shortlist - Public API",
      "description": "Public-facing shortlist submission and status endpoints",
      "item": [
        {
          "name": "Submit Entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.entryId) {",
                  "        pm.collectionVariables.set('entryId', jsonData.entryId);",
                  "        console.log('Entry ID saved:', jsonData.entryId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "teamName",
                  "value": "Team Innovators",
                  "type": "text",
                  "description": "Team name"
                },
                {
                  "key": "githubUrl",
                  "value": "https://github.com/team/repo",
                  "type": "text",
                  "description": "Optional GitHub repository URL"
                },
                {
                  "key": "pptx",
                  "type": "file",
                  "src": [],
                  "description": "PPTX file (max 15 slides)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/shortlist/submit",
              "host": ["{{baseUrl}}"],
              "path": ["shortlist", "submit"]
            },
            "description": "Submit shortlist entry with PPTX presentation"
          },
          "response": []
