            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "Register a new participant. Requires Aadhaar and ID Card image files. Aadhaar is OCR-processed via the Python identity service and encrypted with AES-256."
