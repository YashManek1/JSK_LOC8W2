    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) pm.collectionVariables.set('accessToken', res.accessToken);",
                  "if (res.user && res.user.id) pm.collectionVariables.set('userId', res.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "email", "value": "test@example.com", "type": "text" },
                { "key": "password", "value": "password123", "type": "text" },
                { "key": "fullName", "value": "Test User", "type": "text" },
                { "key": "phone", "value": "9876543210", "type": "text" },
                {
                  "key": "college",
                  "value": "IIT Gandhinagar",
                  "type": "text"
                },
                { "key": "role", "value": "Participant", "type": "text" },
                { "key": "aadhaar", "type": "file", "src": "" },
                { "key": "idCard", "type": "file", "src": "" }
