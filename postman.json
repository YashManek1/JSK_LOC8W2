  "item": [
    {
      "name": "🚀 GitHub Analytics",
      "description": "Real-time GitHub repository analysis with AI-powered codebase evaluation using Repomix + Groq",
      "item": [
        {
          "name": "Sync Repository Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✅ Repository synced successfully');",
                  "    var jsonData = pm.response.json();",
                  "    console.log('Total Commits:', jsonData.totalCommits);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamName\": \"{{teamName}}\",\n  \"githubUrl\": \"https://github.com/facebook/react\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/github/sync/{{teamName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "github",
                "sync",
                "{{teamName}}"
              ]
            },
            "description": "**Force sync GitHub repository statistics**\n\nThis endpoint:\n1. Fetches contributors, commits, languages from GitHub API\n2. Packs codebase using Repomix\n3. Runs Groq AI evaluation against problem statement\n4. Maps features to individual developers\n5. Caches everything in PostgreSQL\n\n**Rate Limits:** Uses GROQ_API_KEY_SECONDARY to isolate quotas"
          }
        },
        {
          "name": "Get Repository Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('GitHub Data:', jsonData.githubData);",
                  "    console.log('AI Analysis:', jsonData.aiData);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/github/stats/{{teamName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "github",
                "stats",
                "{{teamName}}"
              ]
            },
            "description": "**Retrieve cached GitHub statistics**\n\nReturns:\n- `githubData`: Contributors, commits, languages, timeline\n- `aiData`: Implemented features, missing features, relevance score\n\nAuto-syncs if cache is older than 1 hour"
          }
        },
        {
          "name": "Sync by Entry ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"githubUrl\": \"https://github.com/username/repo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/github/sync/{{entryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "github",
                "sync",
                "{{entryId}}"
              ]
            },
            "description": "Sync using shortlist entry UUID instead of team name"
          }
        }
      ]
    },
